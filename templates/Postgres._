<div class='postgres-page'>

  <!-- ── Postgres Server Management ────────────────────────────────── -->
  <ul class='form sunken pg-management'>
    <li class='text pg-management-header'>
      <h3>Postgres Server</h3>
      <div class='pg-actions'>
        <a href='#pg-refresh' class='button pg-btn-refresh'>Refresh</a>
        <a href='#pg-start'   class='button pg-btn-start disabled'>Start Server</a>
        <a href='#pg-stop'    class='button pg-btn-stop disabled'>Stop Server</a>
        <a href='#pg-restart' class='button pg-btn-restart disabled'>Restart Server</a>
      </div>
    </li>
    <li>
      <label>Status</label>
      <span class='db-status-badge'>Checking...</span>
      <span class='db-status-message'></span>
    </li>
    <li class='pg-row-hint' style='display:none'>
      <label></label>
      <span class='pg-stat pg-install-hint'></span>
    </li>
    <li class='text pg-details-toggle'>
      <a href='#pg-details'>
        <span class='pg-toggle-arrow'>&#9654;</span> Postgres Details
      </a>
    </li>
    <li class='pg-detail pg-row-version' style='display:none'>
      <label>Version</label>
      <span class='pg-stat pg-version'></span>
    </li>
    <li class='pg-detail pg-row-install' style='display:none'>
      <label>Installation</label>
      <span class='pg-stat pg-install'></span>
    </li>
    <li class='pg-detail pg-row-bindir' style='display:none'>
      <label>Binaries</label>
      <span class='pg-stat pg-bindir'></span>
    </li>
    <li class='pg-detail pg-row-datadir' style='display:none'>
      <label>Data Directory</label>
      <span class='pg-stat pg-datadir'></span>
    </li>
    <li class='pg-detail pg-row-port' style='display:none'>
      <label>Host / Port</label>
      <span class='pg-stat pg-port'></span>
    </li>
    <li class='pg-detail pg-row-connections' style='display:none'>
      <label>Connections</label>
      <span class='pg-stat pg-connections'></span>
    </li>
    <li class='pg-detail pg-row-osmdb' style='display:none'>
      <label>OSM Database</label>
      <span class='pg-stat pg-osmdb'></span>
    </li>
  </ul>

  <!-- ── Fetch OSM from Overpass ────────────────────────────────────── -->
  <ul class='form sunken'>
    <li class='text'>
      <h3>Fetch OSM Data from OpenStreetMap</h3>
      <p class='description'>Downloads OSM data for the bounding box from Overpass API and loads it into PostgreSQL. The bounding box is defaulted from the current Map extent.</p>
    </li>
    <li class='input-hint-row'>
      <label>Bounding Box</label>
      <input type='text' name='bbox' class='text wide' placeholder='47.598,-122.338,47.663,-122.270' />
      <span class='quiet'>(South, West, North, East)</span>
    </li>
    <li>
      <a href='#fetch' class='button'>Fetch OSM Data</a>
    </li>
  </ul>

  <!-- ── Load from local file ───────────────────────────────────────── -->
  <ul class='form sunken'>
    <li class='text'>
      <h3>Manually Load OSM Data from File</h3>
      <p class='description'>Loads a local .osm or .osm.pbf file into PostgreSQL using osm2pgsql.</p>
    </li>
    <li class='input-hint-row'>
      <label>OSM Path/Filename</label>
      <input type='text' name='file-path' class='text wide' placeholder='/path/to/file.osm' />
    </li>
    <li>
      <a href='#load' class='button'>Load OSM Data</a>
    </li>
  </ul>

  <!-- ── Job output console ─────────────────────────────────────────── -->
  <div class='output-section' style='display:none'>
    <ul class='form sunken'>
      <li class='text'>
        <h3>Job Output <span class='job-status'></span></h3>
      </li>
      <li class='output-wrap'>
        <pre class='output-console'></pre>
      </li>
    </ul>
  </div>

</div>
